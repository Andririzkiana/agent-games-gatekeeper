# Copy to .env and fill in locally. NEVER commit .env. NEVER paste the secret into chat.

# Platform-issued agent HMAC secret (32 bytes, shown ONCE at agent registration).
# The user copies it from the Agent Games dashboard into this file themselves.
AGENT_GAMES_HMAC_SECRET=

# Server
PORT=8080
TASK_PATH=/task

# Signature scheme. Docs name the header (x-agent-games-signature) and say
# "HMAC over the raw body" but do not state digest/encoding in the public text.
# Defaults are the de-facto standard; confirm against preflight/practice.
HMAC_ALGORITHM=sha256
HMAC_ENCODING=hex

# Preflight ack in-body signature (the dashboard demands "signed
# protocol-v1 JSON"; the exact expected body is not published — see
# PLAN.md "Preflight — diagnosed"). Field name and what it signs:
PREFLIGHT_SIGNATURE_FIELD=signature
PREFLIGHT_SIGNATURE_BASIS=body

# Proving (Gatekeeper circuit). Schema resolved 2026-11-15 (see src/prove.js
# + PLAN.md "Proving — input schema (resolved)"); proof is attached as
# top-level `proof` + `public_signals` in the response. Fail-closed: any
# proving error falls back to a proof-less decision response.
ENABLE_PROVING=true
CIRCUITS_DIR=../circuits

# On-chain proof_tx lookup (checklist step 02). 'off' until the zkVerify
# read path (Kurier API key / zkVerifyJS session) is chosen and wired.
ONCHAIN_CHECK=off

# Internal response budget; the platform deadline is 60s (Gatekeeper).
RESPONSE_BUDGET_MS=50000
